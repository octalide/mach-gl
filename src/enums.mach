test "enums: bitfield and primitive values match the registry" {
    if (COLOR_BUFFER_BIT != 0x4000) { ret 1; }
    if (DEPTH_BUFFER_BIT != 0x0100) { ret 1; }
    if (TRIANGLES != 4) { ret 1; }
    if (FALSE != 0) { ret 1; }
    if (TRUE != 1) { ret 1; }
    if (FLOAT != 0x1406) { ret 1; }
    ret 0;
}

test "enums: 64-bit special value keeps its width" {
    if (TIMEOUT_IGNORED != 0xFFFFFFFFFFFFFFFF) { ret 1; }
    ret 0;
}
