    glGetnCompressedTexImage = loader("glGetnCompressedTexImage"):~fun(u32, i32, i32, ptr);
    if (glGetnCompressedTexImage != nil) { n = n + 1; }
    glGetnTexImage = loader("glGetnTexImage"):~fun(u32, i32, u32, u32, i32, ptr);
    if (glGetnTexImage != nil) { n = n + 1; }
    glGetnUniformdv = loader("glGetnUniformdv"):~fun(u32, i32, i32, *f64);
    if (glGetnUniformdv != nil) { n = n + 1; }
    glGetnUniformfv = loader("glGetnUniformfv"):~fun(u32, i32, i32, *f32);
    if (glGetnUniformfv != nil) { n = n + 1; }
    glGetnUniformiv = loader("glGetnUniformiv"):~fun(u32, i32, i32, *i32);
    if (glGetnUniformiv != nil) { n = n + 1; }
    glGetnUniformuiv = loader("glGetnUniformuiv"):~fun(u32, i32, i32, *u32);
    if (glGetnUniformuiv != nil) { n = n + 1; }
    glReadnPixels = loader("glReadnPixels"):~fun(i32, i32, i32, i32, u32, u32, i32, ptr);
    if (glReadnPixels != nil) { n = n + 1; }
    glTextureBarrier = loader("glTextureBarrier"):~fun();
    if (glTextureBarrier != nil) { n = n + 1; }
    glSpecializeShader = loader("glSpecializeShader"):~fun(u32, *u8, u32, *u32, *u32);
    if (glSpecializeShader != nil) { n = n + 1; }
    glMultiDrawArraysIndirectCount = loader("glMultiDrawArraysIndirectCount"):~fun(u32, ptr, i64, i32, i32);
    if (glMultiDrawArraysIndirectCount != nil) { n = n + 1; }
    glMultiDrawElementsIndirectCount = loader("glMultiDrawElementsIndirectCount"):~fun(u32, u32, ptr, i64, i32, i32);
    if (glMultiDrawElementsIndirectCount != nil) { n = n + 1; }
    glPolygonOffsetClamp = loader("glPolygonOffsetClamp"):~fun(f32, f32, f32);
    if (glPolygonOffsetClamp != nil) { n = n + 1; }
    ret n;
}

fun load_nil(name: *u8) ptr {
    ret nil;
}

var load_calls: i64 = 0;

fun load_count(name: *u8) ptr {
    load_calls = load_calls + 1;
    ret (?load_calls)::ptr;
}

# a nil loader resolves nothing and leaves the table nil.
test "c: load with a nil loader resolves nothing" {
    val n: i64 = load(load_nil);
    if (n != 0) { ret 1; }
    if (glClear != nil) { ret 1; }
    ret 0;
}

# a stub loader that answers every name resolves the whole table; the count
# equals the number of loader calls, i.e. the generated command count.
test "c: load with a stub loader resolves every command" {
    load_calls = 0;
    val n: i64 = load(load_count);
    if (n != load_calls) { ret 1; }
    if (n <= 0) { ret 1; }
    ret 0;
}
