    c.glGetnTexImage(target, level, format, type, bufSize, pixels);
}
# wraps glGetnUniformdv
pub fun getn_uniformdv(program: u32, location: i32, bufSize: i32, params: *f64) {
    c.glGetnUniformdv(program, location, bufSize, params);
}
# wraps glGetnUniformfv
pub fun getn_uniformfv(program: u32, location: i32, bufSize: i32, params: *f32) {
    c.glGetnUniformfv(program, location, bufSize, params);
}
# wraps glGetnUniformiv
pub fun getn_uniformiv(program: u32, location: i32, bufSize: i32, params: *i32) {
    c.glGetnUniformiv(program, location, bufSize, params);
}
# wraps glGetnUniformuiv
pub fun getn_uniformuiv(program: u32, location: i32, bufSize: i32, params: *u32) {
    c.glGetnUniformuiv(program, location, bufSize, params);
}
# wraps glReadnPixels
pub fun readn_pixels(x: i32, y: i32, width: i32, height: i32, format: u32, type: u32, bufSize: i32, data: ptr) {
    c.glReadnPixels(x, y, width, height, format, type, bufSize, data);
}
# wraps glTextureBarrier
pub fun texture_barrier() {
    c.glTextureBarrier();
}
# wraps glSpecializeShader
pub fun specialize_shader(shader: u32, pEntryPoint: str, numSpecializationConstants: u32, pConstantIndex: *u32, pConstantValue: *u32) {
    c.glSpecializeShader(shader, pEntryPoint, numSpecializationConstants, pConstantIndex, pConstantValue);
}
# wraps glMultiDrawArraysIndirectCount
pub fun multi_draw_arrays_indirect_count(mode: u32, indirect: ptr, drawcount: i64, maxdrawcount: i32, stride: i32) {
    c.glMultiDrawArraysIndirectCount(mode, indirect, drawcount, maxdrawcount, stride);
}
# wraps glMultiDrawElementsIndirectCount
pub fun multi_draw_elements_indirect_count(mode: u32, type: u32, indirect: ptr, drawcount: i64, maxdrawcount: i32, stride: i32) {
    c.glMultiDrawElementsIndirectCount(mode, type, indirect, drawcount, maxdrawcount, stride);
}
# wraps glPolygonOffsetClamp
pub fun polygon_offset_clamp(factor: f32, units: f32, clamp: f32) {
    c.glPolygonOffsetClamp(factor, units, clamp);
}

# query the GL major and minor version, valid after load
# ---
# major: receives the major version
# minor: receives the minor version
pub fun version(major: *i32, minor: *i32) {
    get_integerv(enums.MAJOR_VERSION, major);
    get_integerv(enums.MINOR_VERSION, minor);
}

var abi_x: i32 = 0;
var abi_y: i32 = 0;
var abi_w: i32 = 0;
var abi_h: i32 = 0;

fun abi_fake(x: i32, y: i32, width: i32, height: i32) {
    abi_x = x;
    abi_y = y;
    abi_w = width;
    abi_h = height;
}

# pin the loaded-pointer call ABI: a Mach fake stands in for glScissor and the
# wrapper must deliver every argument through the table without a GL context.
test "cmd: loaded-pointer call ABI" {
    c.glScissor = abi_fake;
    scissor(11, 22, 33, 44);
    if (abi_x != 11) { ret 1; }
    if (abi_y != 22) { ret 1; }
    if (abi_w != 33) { ret 1; }
    if (abi_h != 44) { ret 1; }
    ret 0;
}
