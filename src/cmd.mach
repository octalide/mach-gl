# version: query the GL major and minor version. valid after load.
# ---
# major: receives the major version
# minor: receives the minor version
pub fun version(major: *i32, minor: *i32) {
    get_integerv(enums.MAJOR_VERSION, major);
    get_integerv(enums.MINOR_VERSION, minor);
}

var abi_x: i32 = 0;
var abi_y: i32 = 0;
var abi_w: i32 = 0;
var abi_h: i32 = 0;

fun abi_fake(x: i32, y: i32, width: i32, height: i32) {
    abi_x = x;
    abi_y = y;
    abi_w = width;
    abi_h = height;
}

# pin the loaded-pointer call ABI: a Mach fake stands in for glScissor and the
# wrapper must deliver every argument through the table without a GL context.
test "cmd: loaded-pointer call ABI" {
    c.glScissor = abi_fake;
    scissor(11, 22, 33, 44);
    if (abi_x != 11) { ret 1; }
    if (abi_y != 22) { ret 1; }
    if (abi_w != 33) { ret 1; }
    if (abi_h != 44) { ret 1; }
    ret 0;
}
