# demo.main: the classic OpenGL triangle, rendered through mach-gl.
#
# opens a 3.3 core-profile context with mach-glfw, loads the GL command table
# through glfw's proc loader, compiles a shader program, uploads a triangle to
# a VAO/VBO, animates the fill color, and closes on window close or ESC. it is
# living documentation of load(), the wrapper idioms, and mach-glfw interop.
#
# this project depends on a context provider so the binding itself never does.

use std.runtime;
use print: std.print;
use std.types.bool.true;
use std.types.bool.false;
use glfw;
use gl;

val VERT_SRC: *u8 = "#version 330 core\nlayout (location = 0) in vec3 aPos;\nvoid main() { gl_Position = vec4(aPos, 1.0); }\n";
val FRAG_SRC: *u8 = "#version 330 core\nout vec4 FragColor;\nuniform vec4 uColor;\nvoid main() { FragColor = uColor; }\n";

fun on_error(code: i32, desc: *u8) {
    print.eprintf("glfw error 0x%x: %s\n", code::u64, desc);
}

fun on_key(handle: ptr, key: i32, scancode: i32, action: i32, mods: i32) {
    if (action == glfw.PRESS && key == glfw.KEY_ESCAPE) {
        val w: glfw.Window = glfw.window_from_handle(handle);
        glfw.set_window_should_close(w, true);
    }
}

# compile: build one shader stage, reporting its info log on failure.
# ---
# kind: gl.VERTEX_SHADER or gl.FRAGMENT_SHADER
# src:  null-terminated GLSL source
# ret:  the shader name, or 0 on failure
fun compile(kind: u32, src: *u8) u32 {
    val shader: u32 = gl.create_shader(kind);
    var srcp: *u8 = src;
    gl.shader_source(shader, 1, ?srcp, nil);
    gl.compile_shader(shader);
    var ok: i32 = 0;
    gl.get_shaderiv(shader, gl.COMPILE_STATUS, ?ok);
    if (ok == 0) {
        var log: [1024]u8;
        gl.get_shader_info_log(shader, 1024, nil, ?log[0]);
        print.eprintf("shader compile failed: %s\n", ?log[0]);
        ret 0;
    }
    ret shader;
}

`symbol("main")`
fun main(argc: i64, argv: **u8) i64 {
    glfw.set_error_callback(on_error);
    if (!glfw.init()) {
        print.eprintln("failed to initialize GLFW");
        ret 1;
    }

    glfw.window_hint(glfw.CONTEXT_VERSION_MAJOR, 3);
    glfw.window_hint(glfw.CONTEXT_VERSION_MINOR, 3);
    glfw.window_hint(glfw.OPENGL_PROFILE, glfw.OPENGL_CORE_PROFILE);

    val w: glfw.Window = glfw.open_window(800, 600, "mach-gl triangle");
    if (!glfw.window_is_valid(w)) {
        print.eprintln("failed to create window");
        glfw.terminate();
        ret 1;
    }
    glfw.make_context_current(w);
    glfw.swap_interval(1);
    glfw.set_key_callback(w, on_key);

    val resolved: i64 = gl.load(glfw.get_proc_address);
    print.printf("loaded %d GL commands\n", resolved);

    var major: i32 = 0;
    var minor: i32 = 0;
    gl.version(?major, ?minor);
    print.printf("OpenGL %d.%d\n", major::i64, minor::i64);

    val vs: u32 = compile(gl.VERTEX_SHADER, VERT_SRC);
    val fs: u32 = compile(gl.FRAGMENT_SHADER, FRAG_SRC);
    if (vs == 0 || fs == 0) {
        glfw.terminate();
        ret 1;
    }

    val prog: u32 = gl.create_program();
    gl.attach_shader(prog, vs);
    gl.attach_shader(prog, fs);
    gl.link_program(prog);
    var linked: i32 = 0;
    gl.get_programiv(prog, gl.LINK_STATUS, ?linked);
    if (linked == 0) {
        var log: [1024]u8;
        gl.get_program_info_log(prog, 1024, nil, ?log[0]);
        print.eprintf("program link failed: %s\n", ?log[0]);
        glfw.terminate();
        ret 1;
    }
    gl.delete_shader(vs);
    gl.delete_shader(fs);

    var verts: [9]f32 = [9]f32{
        -0.5, -0.5, 0.0,
         0.5, -0.5, 0.0,
         0.0,  0.5, 0.0,
    };
    var vao: u32 = 0;
    var vbo: u32 = 0;
    gl.gen_vertex_arrays(1, ?vao);
    gl.gen_buffers(1, ?vbo);
    gl.bind_vertex_array(vao);
    gl.bind_buffer(gl.ARRAY_BUFFER, vbo);
    gl.buffer_data(gl.ARRAY_BUFFER, 36, (?verts)::ptr, gl.STATIC_DRAW);
    gl.vertex_attrib_pointer(0, 3, gl.FLOAT, false, 12, nil);
    gl.enable_vertex_attrib_array(0);

    val ucolor: i32 = gl.get_uniform_location(prog, "uColor");

    for (!glfw.window_should_close(w)) {
        val t:     f64 = glfw.get_time();
        val phase: f64 = (t * 0.5) % 1.0;
        gl.clear_color(0.1, 0.1, 0.12, 1.0);
        gl.clear(gl.COLOR_BUFFER_BIT);
        gl.use_program(prog);
        gl.uniform4f(ucolor, phase::f32, 1.0 - phase::f32, 0.4, 1.0);
        gl.bind_vertex_array(vao);
        gl.draw_arrays(gl.TRIANGLES, 0, 3);
        glfw.swap_buffers(w);
        glfw.poll_events();
    }

    glfw.destroy_window(w);
    glfw.terminate();
    print.println("bye");
    ret 0;
}
